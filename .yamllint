# .yamllint — Config Stub (config_model: native, ADR-0033).
# Extends the shared yamllint floor in the Shared Config Checkout. yamllint
# reads `extends` and `ignore-from-file` paths from the directory it runs in,
# so run it from the repository root; a missing file is a hard error.
#
# Repository rules go under `rules:`; a rule's options here override the
# shared ones. To ignore more paths, list them in a repository
# `.yamllint-ignore` (gitignore syntax) and add, shared file first:
#
#   ignore-from-file:
#     - .standards-config/config/yamllint-ignore
#     - .yamllint-ignore
#
# Never use `ignore:` here: it would replace the shared ignores.
extends: .standards-config/config/yamllint.yml
