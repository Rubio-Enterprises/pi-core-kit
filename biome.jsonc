{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["**/*", "!**/node_modules", "!**/dist", "!**/build", "!**/coverage", "!**/reports"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
