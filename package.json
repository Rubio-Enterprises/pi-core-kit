{
  "name": "pi-core-kit",
  "version": "2.0.0",
  "description": "Host-independent building blocks for Pi extensions: config files and session caches.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./config-file": "./src/config-file.ts",
    "./session-cache": "./src/session-cache.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.project.json && tsc -p tsconfig.tests.json",
    "lint": "mise exec -- biome check .",
    "test": "bun run scripts/run-tests.ts",
    "typecheck": "tsc -p tsconfig.project.json && tsc -p tsconfig.tests.json"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "typebox": "^1.3.27"
  }
}
